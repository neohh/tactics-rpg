@tool
extends EditorScript

const MAIN_SCENE := "res://main.tscn"

const UNIT_GD := """
extends Node2D
const CELL = 64
const DIRS = [Vector2i(0,-1),Vector2i(1,-1),Vector2i(1,0),Vector2i(1,1),Vector2i(0,1),Vector2i(-1,1),Vector2i(-1,0),Vector2i(-1,-1)]
var cell: Vector2i
var team: int
var unit_name: String
var color: Color
var max_hp: int
var hp: int
var move_range: int
var attack_range: int = 1
var damage: int = 1
var chance_front: float
var chance_back: float
var moved := false
var attacked := false
var facing := 0
var show_zones := false
var dist_based := false
var tex: Texture2D = null
var img_scale: float = 1.0
func is_alive() -> bool:
	return hp > 0
func take_damage(a: int):
	hp -= a
	if hp < 0:
		hp = 0
func reset_turn():
	moved = false
	attacked = false
func rotate_by(d: int):
	facing = (facing + d + 8) % 8
func dir_index(d: Vector2i) -> int:
	for i in DIRS.size():
		if DIRS[i] == d:
			return i
	return 0
func face_toward(t: Vector2i):
	var dx = t.x - cell.x
	var dy = t.y - cell.y
	if dx == 0 and dy == 0:
		return
	facing = dir_index(Vector2i(sign(dx), sign(dy)))
func zone_for(t: Vector2i) -> String:
	var dx = t.x - cell.x
	var dy = t.y - cell.y
	if dx == 0 and dy == 0:
		return "front"
	var rel = (dir_index(Vector2i(sign(dx), sign(dy))) - facing + 8) % 8
	if rel == 7 or rel == 0 or rel == 1:
		return "front"
	if rel >= 3 and rel <= 5:
		return "back"
	return "side"
func chance_for_zone(z: String) -> float:
	if z == "front":
		return chance_front
	if z == "back":
		return chance_back
	return (chance_front + chance_back) / 2.0
func _draw():
	var r = CELL * 0.35
	if show_zones:
		for i in DIRS.size():
			var rel = (i - facing + 8) % 8
			var col: Color
			if rel == 7 or rel == 0 or rel == 1:
				col = Color(0, 1, 0, 0.2)
			elif rel >= 3 and rel <= 5:
				col = Color(1, 0, 0, 0.2)
			else:
				col = Color(1, 1, 0, 0.2)
			draw_circle(Vector2(DIRS[i]) * CELL, r * 0.8, col)
	if tex != null:
		var s = 60.0 * img_scale
		draw_texture_rect(tex, Rect2(-s * 0.5, -s * 0.5, s, s))
	else:
		draw_circle(Vector2.ZERO, r, color)
		draw_arc(Vector2.ZERO, r, 0, TAU, 32, Color.WHITE, 2.0)
		var letter = unit_name.substr(0, 1)
		var font = ThemeDB.fallback_font
		var ts = font.get_string_size(letter, HORIZONTAL_ALIGNMENT_CENTER, -1, 20)
		draw_string(font, Vector2(-ts.x * 0.5, ts.y * 0.25), letter, HORIZONTAL_ALIGNMENT_CENTER, -1, 20, Color.WHITE)
	var dv = Vector2(DIRS[facing])
	draw_line(dv * r * 0.5, dv * r * 1.2, Color.WHITE, 3.0)
	var bw = CELL * 0.8
	draw_rect(Rect2(-bw * 0.5, r + 8, bw, 6), Color(0.3, 0.3, 0.3))
	draw_rect(Rect2(-bw * 0.5, r + 8, bw * float(hp) / float(max_hp), 6), Color(0, 1, 0))

"""

const ENEMY_GD := """
extends "res://scripts/unit.gd"
func choose_action(all_units, gw, gh, rocks = [], fires = {}):
	var res = {}
	var target = _weakest_player(all_units)
	if target == null:
		return res
	if _can_hit_from(cell, target.cell, rocks, attack_range):
		res["attack"] = target
		return res
	var move_to = _step_toward(all_units, gw, gh, rocks, fires, target)
	if move_to != null:
		res["move_to"] = move_to
		if _can_hit_from(move_to, target.cell, rocks, attack_range):
			res["attack"] = target
	return res
func _can_hit_from(from, tcell, rocks, ar):
	var d = tcell - from
	if max(abs(d.x), abs(d.y)) > ar:
		return false
	if ar == 1 and abs(d.x) == 1 and abs(d.y) == 1:
		if rocks.has(from + Vector2i(d.x, 0)) or rocks.has(from + Vector2i(0, d.y)):
			return false
	return true
func _step_toward(all_units, gw, gh, rocks, fires, target):
	var dist = {cell: 0}
	var frontier = [cell]
	var ORTH = [Vector2i(1,0),Vector2i(-1,0),Vector2i(0,1),Vector2i(0,-1)]
	while frontier.size() > 0:
		var nxt = []
		for c in frontier:
			if dist[c] >= move_range:
				continue
			for d in ORTH:
				var n = c + d
				if n.x < 0 or n.y < 0 or n.x >= gw or n.y >= gh:
					continue
				if rocks.has(n) or dist.has(n):
					continue
				var occ = _unit_at(all_units, n)
				if occ != null and occ != self:
					continue
				dist[n] = dist[c] + 1
				nxt.append(n)
		frontier = nxt
	var cur_s = _score(cell, target, fires)
	var best = null
	var bs = 1e9
	for c in dist:
		if c == cell:
			continue
		var s = _score(c, target, fires)
		if s < bs:
			bs = s
			best = c
	if best == null or bs >= cur_s:
		return null
	return best
func _score(c, target, fires):
	var s = float(_cheb(c, target.cell)) * 10.0
	var z = target.zone_for(c)
	if z == "back":
		s -= 1.0
	elif z == "side":
		s -= 0.5
	if fires.has(c):
		s += 4.0
	if fires.has(cell) and not fires.has(c):
		s -= 6.0
	s += (c.x + c.y) * 0.01
	return s
func _weakest_player(all_units):
	var best = null
	var bh = 1e9
	for u in all_units:
		if u.team == 0 and u.is_alive() and u.hp < bh:
			bh = u.hp
			best = u
	return best
func _cheb(a, b):
	return max(abs(a.x - b.x), abs(a.y - b.y))
func _unit_at(all_units, c):
	for u in all_units:
		if u.is_alive() and u.cell == c:
			return u
	return null

"""

const BOARD_GD := """extends Control

const CELL := 64

var grid_w := 8
var grid_h := 6
var move_cells := []
var attack_cells := []
var selected_cell := Vector2i(-1, -1)

func set_highlights(mv: Array, atk: Array,
		sel: Vector2i) -> void:
	move_cells = mv
	attack_cells = atk
	selected_cell = sel
	queue_redraw()

func clear_highlights() -> void:
	move_cells = []
	attack_cells = []
	selected_cell = Vector2i(-1, -1)
	queue_redraw()

func cell_at(local_pos: Vector2) -> Vector2i:
	if local_pos.x < 0 or local_pos.y < 0:
		return Vector2i(-1, -1)
	var cx := int(local_pos.x / CELL)
	var cy := int(local_pos.y / CELL)
	if cx >= grid_w or cy >= grid_h:
		return Vector2i(-1, -1)
	return Vector2i(cx, cy)

func _draw() -> void:
	var bw := grid_w * CELL
	var bh := grid_h * CELL
	draw_rect(Rect2(0, 0, bw, bh),
			Color(0.10, 0.10, 0.13))
	for c in move_cells:
		draw_rect(_cell_rect(c),
				Color(0.2, 0.9, 0.3, 0.45))
		draw_rect(_cell_rect(c),
				Color(0.2, 0.9, 0.3), false, 2.0)
	for x in range(grid_w + 1):
		draw_line(Vector2(x * CELL, 0),
				Vector2(x * CELL, bh),
				Color(0.35, 0.35, 0.4), 1.0)
	for y in range(grid_h + 1):
		draw_line(Vector2(0, y * CELL),
				Vector2(bw, y * CELL),
				Color(0.35, 0.35, 0.4), 1.0)
	if selected_cell != Vector2i(-1, -1):
		draw_rect(_cell_rect(selected_cell),
				Color(1.0, 0.9, 0.2, 0.35))
	for c in attack_cells:
		draw_rect(_cell_rect(c),
				Color(1.0, 0.2, 0.2, 0.4))
		draw_rect(_cell_rect(c),
				Color(1.0, 0.2, 0.2), false, 2.0)

func _cell_rect(c: Vector2i) -> Rect2:
	var px := c.x * CELL + 2
	var py := c.y * CELL + 2
	return Rect2(px, py, CELL - 4, CELL - 4)
"""

const MAIN_GD := """
extends Control
const GRID_W = 8
const GRID_H = 6
const CELL = 64
const ORTH = [Vector2i(1,0),Vector2i(-1,0),Vector2i(0,1),Vector2i(0,-1)]
@onready var board = $Board
@onready var units_root = $Units
@onready var status_label = $StatusLabel
@onready var end_turn_button = $EndTurnButton
var units = []
var move_cells = []
var attack_cells = []
var selected = null
var acted_unit = null
var current_team = 0
var busy = false
var game_over = false
var down_cell = null
var rocks = []
var fires = {}
var fire_charges = 2
var fb_mode = false
var CLASSES = {}
var CHARS = {}
var ITEMS = {}
var loot_of = {}
var cls_of = {}
var objects = {}
var obj_kind = "rock"
var OBJ_TYPES = {}
var deploy_mode := false
var tool := "move"
var deploy_cls := "swordsman"
var deploy_sel = null
var toolbar = null
var potion_button = null
var LOCS = {}
var dlg_node = null
var cur_loc = "test"
const CLS_ORDER = ["swordsman", "assassin", "halberd", "archer"]
func _ready():
	end_turn_button.pressed.connect(_on_end_turn)
	CLASSES = _load_json("res://data/classes.json")
	CHARS = _load_json("res://data/chars.json")
	ITEMS = _load_json("res://data/items.json")
	LOCS = _load_json("res://data/locations.json")
	OBJ_TYPES = _load_json("res://data/objects.json")
	if potion_button == null:
		_build_potion_btn()
	new_game()
func _load_json(p):
	var f = FileAccess.open(p, FileAccess.READ)
	if f == null:
		return {}
	var s = f.get_as_text()
	f.close()
	var j = JSON.parse_string(s)
	return {} if j == null else j
func new_game():
	for u in units:
		u.queue_free()
	for n in get_tree().get_nodes_in_group("rocks"):
		n.queue_free()
	for n in get_tree().get_nodes_in_group("fires"):
		n.queue_free()
	units.clear()
	loot_of = {}
	cls_of = {}
	selected = null
	acted_unit = null
	current_team = 0
	busy = false
	game_over = false
	down_cell = null
	fires = {}
	fire_charges = 2
	fb_mode = false
	objects = {}
	var loc = LOCS.get(Game.cur_loc, {})
	var m = loc.get("map", {})
	var used = false
	if m.size() > 0 and m.get("units", []).size() > 0:
		for r in m.get("rocks", []):
			objects[Vector2i(r[0], r[1])] = "rock"
		for o in m.get("objects", []):
			objects[Vector2i(o["cell"][0], o["cell"][1])] = o.get("k", "rock")
		var has0 = false
		for e in m.get("units", []):
			if int(e.get("team", 1)) == 0:
				has0 = true
		if not has0:
			spawn_unit("assassin", Vector2i(1,1), 0)
			spawn_unit("swordsman", Vector2i(1,2), 0)
			spawn_unit("halberd", Vector2i(1,3), 0)
			spawn_unit("archer", Vector2i(1,4), 0)
		for e in m.get("units", []):
			spawn_unit(e.get("cls", "swordsman"), Vector2i(e["cell"][0], e["cell"][1]), int(e.get("team", 1)))
		used = true
	if not used:
		for r in [Vector2i(3,0),Vector2i(4,1),Vector2i(2,3),Vector2i(5,2),Vector2i(3,4),Vector2i(4,5)]:
			objects[r] = "rock"
		objects[Vector2i(4,3)] = "tree"
		spawn_unit("assassin", Vector2i(1,1), 0)
		spawn_unit("swordsman", Vector2i(1,2), 0)
		spawn_unit("halberd", Vector2i(1,3), 0)
		spawn_unit("archer", Vector2i(1,4), 0)
		spawn_unit("assassin", Vector2i(6,1), 1)
		spawn_unit("swordsman", Vector2i(6,2), 1)
		spawn_unit("halberd", Vector2i(6,3), 1)
		spawn_unit("archer", Vector2i(6,4), 1)
	rocks = objects.keys()
	_spawn_rocks()
	_clear_hl()
	deploy_mode = true
	if toolbar == null:
		_build_toolbar()
	else:
		toolbar.visible = true
	_set_status("Расстановка: выбери инструмент внизу. «В БОЙ» — начать.")
func spawn_unit(cls_id, c, tm, char_id = ""):
	var cd = CLASSES.get(cls_id, {})
	var u
	if tm == 1:
		u = load("res://scripts/enemy_unit.gd").new()
	else:
		u = load("res://scripts/unit.gd").new()
	var ch = {}
	if char_id != "":
		ch = CHARS.get(char_id, {})
	u.unit_name = ch.get("name", cd.get("name", cls_id))
	u.cell = c
	u.team = tm
	u.color = _unit_color(cls_id, tm)
	u.max_hp = int(cd.get("hp", 2))
	u.hp = u.max_hp
	u.move_range = int(cd.get("move", 3))
	u.chance_front = float(cd.get("cf", 0.6))
	u.chance_back = float(cd.get("cb", 0.6))
	u.facing = 2 if tm == 0 else 6
	u.attack_range = int(cd.get("ar", 1))
	u.dist_based = cd.get("db", false)
	u.img_scale = float(cd.get("scale", 1.0))
	var img = cd.get("img", "")
	if ch.get("img", "") != "":
		img = ch.get("img", "")
	if img != "" and ResourceLoader.exists(img):
		u.tex = load(img)
	u.position = Vector2(c) * CELL + Vector2(32, 32)
	loot_of[u] = cd.get("loot", [])
	cls_of[u] = cls_id
	units_root.add_child(u)
	units.append(u)
func _unit_color(cls_id, tm):
	var base = {"assassin": Color(0.8,0.2,0.6), "swordsman": Color(0.2,0.5,0.9), "halberd": Color(0.9,0.6,0.1), "archer": Color(0.6,0.9,1.0)}.get(cls_id, Color(0.7,0.7,0.7))
	if tm == 1:
		base = Color(1.0, 0.25, 0.25).lerp(base, 0.35)
	return base
func _unhandled_input(ev):
	if ev is InputEventKey and ev.pressed:
		if ev.keycode == KEY_J:
			_toggle_journal()
			return
		if ev.keycode == KEY_J:
			_toggle_journal()
			return
		if ev.keycode == KEY_R:
			new_game()
			return
		if ev.keycode == KEY_M and game_over and not busy:
			get_tree().change_scene_to_file("res://overworld.tscn")
			return
		if ev.keycode == KEY_D and not busy and not game_over and not deploy_mode:
			_play_dlg("sample")
			return
		if selected != null and selected.team == 0 and not busy and not game_over and not deploy_mode:
			if ev.keycode == KEY_Q:
				selected.rotate_by(-1)
				selected.queue_redraw()
				_compute_highlights()
			elif ev.keycode == KEY_E:
				selected.rotate_by(1)
				selected.queue_redraw()
				_compute_highlights()
			elif ev.keycode == KEY_F:
				if fire_charges > 0 and not selected.attacked:
					fb_mode = not fb_mode
					_compute_highlights()
					if fb_mode:
						_set_status("Огненный шар: выбери клетку в радиусе 4. F — отмена.")
					else:
						_set_status("Твой ход!")
			elif ev.keycode == KEY_1:
				if Game.has_item("potion") and selected.hp < selected.max_hp:
					Game.remove_item("potion")
					selected.hp = min(selected.max_hp, selected.hp + int(ITEMS.get("potion", {}).get("heal", 1)))
					selected.queue_redraw()
					_float_text(selected.position, "+1", Color(0.4, 1, 0.4))
					_set_status("Зелье использовано.")
	if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_LEFT:
		if deploy_mode:
			if ev.pressed:
				_deploy_click(board.cell_at(board.get_local_mouse_position()))
			return
		if busy or game_over:
			return
		if ev.pressed:
			down_cell = board.cell_at(board.get_local_mouse_position())
		else:
			var up = board.cell_at(board.get_local_mouse_position())
			var dc = down_cell
			down_cell = null
			if up == null or dc == null:
				return
			if fb_mode:
				if dc == up and up in attack_cells:
					_do_cast(selected, up)
				else:
					fb_mode = false
					_compute_highlights()
				return
			if dc == up:
				_click(up)
			elif selected != null and dc == selected.cell:
				_try_act(up)
			else:
				var u0 = _unit_at(dc)
				if u0 != null and u0.team == 0 and (acted_unit == null or u0 == acted_unit):
					selected = u0
					u0.show_zones = true
					u0.queue_redraw()
					_compute_highlights()
					_try_act(up)
func _click(c):
	if not _in_grid(c):
		return
	if fb_mode:
		if c in attack_cells:
			_do_cast(selected, c)
		else:
			fb_mode = false
			_compute_highlights()
		return
	if selected != null and _try_act(c):
		return
	var u = _unit_at(c)
	if selected != null:
		selected.show_zones = false
		selected.queue_redraw()
	if u != null and u.team == 0 and not game_over and not busy:
		if acted_unit != null and u != acted_unit:
			_set_status("За ход действует одна фигура!")
			selected = null
			_clear_hl()
			return
		selected = u
		u.show_zones = true
		u.queue_redraw()
		_compute_highlights()
		_set_status(u.unit_name + ": жёлтые=ход, красные=атака, Q/E=поворот, F=шар")
	else:
		selected = null
		_clear_hl()
func _try_act(c):
	if selected == null or busy or game_over or fb_mode:
		return false
	if not selected.moved and c in move_cells:
		_do_move(selected, c)
		return true
	if not selected.attacked and c in attack_cells:
		var t = _unit_at(c)
		if t != null and t.team != selected.team:
			_do_attack(selected, t)
			return true
	return false
func _do_move(u, c):
	busy = true
	u.moved = true
	acted_unit = u
	await _animate_move(u, c)
	_compute_highlights()
	_set_status(u.unit_name + " сходил. Атака или конец хода.")
	busy = false
func _animate_move(u, target):
	var par = _bfs(u)
	var path = []
	if par.has(target):
		var c = target
		while c != u.cell and c != null:
			path.push_front(c)
			c = par[c]
	if path.size() == 0:
		path = [target]
	var tw = create_tween()
	var prev = u.cell
	for wp in path:
		var d = wp - prev
		tw.tween_callback(_set_facing.bind(u, u.dir_index(d)))
		tw.tween_property(u, "position", Vector2(wp) * CELL + Vector2(32, 32), 0.13).set_trans(Tween.TRANS_LINEAR)
		prev = wp
	u.cell = target
	await tw.finished
	u.queue_redraw()
func _set_facing(u, idx):
	u.facing = idx
	u.queue_redraw()
func _bfs(u):
	var par = {u.cell: null}
	var dist = {u.cell: 0}
	var frontier = [u.cell]
	while frontier.size() > 0:
		var nxt = []
		for c in frontier:
			if dist[c] >= u.move_range:
				continue
			for d in ORTH:
				var n = c + d
				if _in_grid(n) and not par.has(n) and _unit_at(n) == null and not rocks.has(n):
					par[n] = c
					dist[n] = dist[c] + 1
					nxt.append(n)
		frontier = nxt
	return par
func _move_cells_for(u):
	var par = _bfs(u)
	var res = []
	for c in par:
		if c != u.cell:
			res.append(c)
	return res
func _do_attack(a, t):
	busy = true
	a.face_toward(t.cell)
	a.queue_redraw()
	await _resolve_attack(a, t)
	if game_over:
		busy = false
		return
	a.attacked = true
	acted_unit = a
	await _end_player_turn()
func _resolve_attack(a, t):
	var chance = 0.5
	var ztext = ""
	if a.dist_based:
		var d = _cheb(a.cell, t.cell)
		chance = clampf(1.35 - 0.15 * float(d), 0.1, 1.0)
		ztext = "с %d кл." % d
	else:
		var zone = t.zone_for(a.cell)
		chance = a.chance_for_zone(zone)
		ztext = _zone_name(zone)
	if a.team == 0:
		chance -= 0.05 * float(Game.fatigue)
	if randf() < chance:
		t.take_damage(1)
		t.queue_redraw()
		_float_text(t.position, "-1", Color(1, 0.3, 0.3))
		_set_status("%s попал по %s (%s)!" % [a.unit_name, t.unit_name, ztext])
		await _anim_hit(t)
		if not t.is_alive():
			_kill(t)
			await _anim_death(t)
	else:
		_float_text(t.position, "мимо", Color(0.8, 0.8, 1))
		_set_status("%s промахнулся по %s (%s)." % [a.unit_name, t.unit_name, ztext])
		await _anim_dodge(t)
	_check_end()
func _kill(t):
	units.erase(t)
	var got = Game.roll_loot(loot_of.get(t, []))
	for g in got:
		_float_text(t.position, "+1 %s" % g, Color(0.4, 1, 0.4))
	if got.size() > 0:
		_set_status("%s погиб! Лут: %s" % [t.unit_name, ", ".join(got)])
	else:
		_set_status("%s погиб!" % t.unit_name)
func _anim_hit(u):
	var base = u.position
	var tw = create_tween()
	tw.tween_property(u, "modulate", Color(1, 0.4, 0.4), 0.08)
	tw.tween_property(u, "position", base + Vector2(5, 0), 0.05)
	tw.tween_property(u, "position", base + Vector2(-5, 0), 0.05)
	tw.tween_property(u, "position", base, 0.05)
	tw.tween_property(u, "modulate", Color.WHITE, 0.15)
	await tw.finished
func _anim_dodge(u):
	var base = u.position
	var tw = create_tween()
	tw.tween_property(u, "position", base + Vector2(0, -12), 0.09)
	tw.tween_property(u, "position", base, 0.09)
	tw.tween_property(u, "modulate", Color(0.7, 0.9, 1), 0.1)
	tw.tween_property(u, "modulate", Color.WHITE, 0.15)
	await tw.finished
func _anim_death(u):
	var tw = create_tween()
	tw.tween_property(u, "modulate:a", 0.0, 0.45)
	tw.parallel().tween_property(u, "scale", Vector2(0.2, 0.2), 0.45)
	tw.tween_callback(u.queue_free)
	await tw.finished
func _float_text(pos, txt, col):
	var l = Label.new()
	l.text = txt
	l.position = pos + Vector2(-16, -40)
	l.add_theme_color_override("font_color", col)
	l.add_theme_font_size_override("font_size", 16)
	units_root.add_child(l)
	var tw = create_tween()
	tw.tween_property(l, "position:y", l.position.y - 30, 0.7)
	tw.parallel().tween_property(l, "modulate:a", 0.0, 0.7)
	tw.tween_callback(l.queue_free)
func _zone_name(z):
	if z == "front":
		return "лоб"
	if z == "back":
		return "спина"
	return "бок"
func _compute_highlights():
	move_cells = []
	attack_cells = []
	if selected == null:
		_clear_hl()
		return
	if fb_mode:
		for x in range(selected.cell.x - 4, selected.cell.x + 5):
			for y in range(selected.cell.y - 4, selected.cell.y + 5):
				var cc = Vector2i(x, y)
				if _in_grid(cc):
					attack_cells.append(cc)
		board.move_cells = []
		board.attack_cells = attack_cells
		board.selected_cell = selected.cell
		board.queue_redraw()
		return
	if not selected.moved:
		move_cells = _move_cells_for(selected)
	if not selected.attacked:
		for u in units:
			if u.is_alive() and u.team != selected.team and _cheb(selected.cell, u.cell) <= selected.attack_range:
				if selected.dist_based or _melee_clear(selected, u):
					attack_cells.append(u.cell)
	board.move_cells = move_cells
	board.attack_cells = attack_cells
	board.selected_cell = selected.cell
	board.queue_redraw()
func _clear_hl():
	board.move_cells = []
	board.attack_cells = []
	board.selected_cell = Vector2i(-1, -1)
	board.queue_redraw()
func _on_end_turn():
	if busy or game_over or current_team != 0 or deploy_mode:
		return
	busy = true
	await _end_player_turn()
func _end_player_turn():
	selected = null
	acted_unit = null
	fb_mode = false
	for u in units:
		u.show_zones = false
		u.queue_redraw()
	_clear_hl()
	current_team = 1
	await _enemy_phase()
	await _tick_fires()
	if game_over:
		return
	current_team = 0
	for u in units:
		if u.team == 0 and u.is_alive():
			u.reset_turn()
	busy = false
	_set_status("Твой ход! F — шар (%d), 1 — зелье." % fire_charges)
func _enemy_phase():
	for u in units:
		if u.team == 1 and u.is_alive():
			u.reset_turn()
	var actor = _pick_enemy_actor()
	if actor != null:
		await get_tree().create_timer(0.4).timeout
		var act = actor.choose_action(units, GRID_W, GRID_H, rocks, fires)
		if act.has("move_to"):
			await _animate_move(actor, act["move_to"])
			actor.moved = true
			await get_tree().create_timer(0.15).timeout
		if act.has("attack") and not actor.attacked:
			var tt = act["attack"]
			if tt.is_alive() and _cheb(actor.cell, tt.cell) <= actor.attack_range:
				actor.attacked = true
				actor.face_toward(tt.cell)
				actor.queue_redraw()
				await _resolve_attack(actor, tt)
				await get_tree().create_timer(0.2).timeout
	_check_end()
func _pick_enemy_actor():
	var alive = []
	for u in units:
		if u.team == 1 and u.is_alive():
			alive.append(u)
	if alive.size() == 0:
		return null
	var t = _weakest_player()
	if t == null:
		return alive[0]
	var best = null
	var bs = 1e9
	for u in alive:
		var act = u.choose_action(units, GRID_W, GRID_H, rocks, fires)
		var sc = 1e9
		if act.has("attack"):
			sc = float(_cheb(u.cell, act["attack"].cell))
		elif act.has("move_to"):
			sc = 10.0 + float(_cheb(act["move_to"], t.cell))
		if sc < bs:
			bs = sc
			best = u
	return best
func _can_attack_any(u):
	for p in units:
		if p.team == 0 and p.is_alive() and _cheb(u.cell, p.cell) <= u.attack_range:
			return true
	return false
func _nearest_player_dist(u):
	var bd = 1e9
	for p in units:
		if p.team == 0 and p.is_alive():
			var d = _cheb(u.cell, p.cell)
			if d < bd:
				bd = d
	return bd
func _check_end():
	var p = 0
	var e = 0
	for u in units:
		if u.is_alive():
			if u.team == 0:
				p += 1
			else:
				e += 1
	if e == 0 and not game_over:
		game_over = true
		Game.flags["clear_" + Game.cur_loc] = true
		Game.clear_hook(Game.cur_loc)
		_set_status("ПОБЕДА! M — на карту, R — заново.")
		_after_win()
	elif p == 0 and not game_over:
		game_over = true
		_set_status("Поражение… M — на карту, R — заново.")
func _cheb(a, b):
	return max(abs(a.x - b.x), abs(a.y - b.y))
func _unit_at(c):
	for u in units:
		if u.is_alive() and u.cell == c:
			return u
	return null
func _in_grid(c):
	return c.x >= 0 and c.y >= 0 and c.x < GRID_W and c.y < GRID_H
func _set_status(t):
	status_label.text = t
	_update_potion_btn()
func _spawn_rocks():
	for c in objects:
		var n = load("res://scripts/obj_node.gd").new()
		n.kind = objects[c]
		var img = OBJ_TYPES.get(objects[c], {}).get("img", "")
		if img != "" and ResourceLoader.exists(img):
			n.tex = load(img)
		n.position = Vector2(c) * CELL + Vector2(32, 32)
		n.add_to_group("rocks")
		units_root.add_child(n)
func _refresh_fire_nodes():
	for n in get_tree().get_nodes_in_group("fires"):
		n.queue_free()
	for k in fires.keys():
		var r = ColorRect.new()
		r.size = Vector2(CELL - 4, CELL - 4)
		r.position = Vector2(k) * CELL + Vector2(2, 2)
		r.color = Color(1, 0.45, 0, 0.25 + 0.15 * fires[k])
		r.add_to_group("fires")
		units_root.add_child(r)
func _anim_boom(c):
	var r = ColorRect.new()
	r.color = Color(1, 0.5, 0, 0.6)
	r.size = Vector2(CELL * 3, CELL * 3)
	r.position = Vector2(c - Vector2i(1, 1)) * CELL
	units_root.add_child(r)
	var tw = create_tween()
	tw.tween_property(r, "modulate:a", 0.0, 0.5)
	tw.tween_callback(r.queue_free)
	await tw.finished
func _do_cast(u, c):
	fb_mode = false
	busy = true
	fire_charges -= 1
	u.attacked = true
	acted_unit = u
	u.face_toward(c)
	u.queue_redraw()
	_set_status("Огненный шар!")
	_float_text(Vector2(c) * CELL + Vector2(32, 32), "БАХ!", Color(1, 0.6, 0))
	await _anim_boom(c)
	for dx in range(-1, 2):
		for dy in range(-1, 2):
			var cc = c + Vector2i(dx, dy)
			if _in_grid(cc) and not rocks.has(cc):
				fires[cc] = 3
	_refresh_fire_nodes()
	for uu in units.duplicate():
		if uu.is_alive() and abs(uu.cell.x - c.x) <= 1 and abs(uu.cell.y - c.y) <= 1:
			uu.take_damage(1)
			uu.queue_redraw()
			_float_text(uu.position, "-1", Color(1, 0.3, 0.3))
			await _anim_hit(uu)
			if not uu.is_alive():
				_kill(uu)
				await _anim_death(uu)
	_check_end()
	if game_over:
		busy = false
		return
	await _end_player_turn()
func _tick_fires():
	if fires.size() == 0:
		return
	for u in units.duplicate():
		if u.is_alive() and fires.has(u.cell):
			u.take_damage(1)
			u.queue_redraw()
			_float_text(u.position, "огонь -1", Color(1, 0.5, 0))
			await _anim_hit(u)
			if not u.is_alive():
				_kill(u)
				await _anim_death(u)
	for k in fires.keys():
		fires[k] -= 1
		if fires[k] <= 0:
			fires.erase(k)
	_refresh_fire_nodes()
	_check_end()

func _build_toolbar():
	toolbar = HBoxContainer.new()
	toolbar.position = Vector2(0, GRID_H * CELL + 30)
	add_child(toolbar)
	for t in ["✋", "🪨", "Объект", "❌", "+Свои", "+Враг", "Класс", "Авто", "Очист", "Сохран", "Загруз", "В БОЙ"]:
		var b = Button.new()
		b.text = t
		b.pressed.connect(_tb.bind(t))
		toolbar.add_child(b)
func _tb(t):
	if t == "✋":
		tool = "move"
	elif t == "🪨":
		tool = "rock"
	elif t == "Объект":
		var order = ["rock", "tree", "house", "tent", "crate"]
		obj_kind = order[(order.find(obj_kind) + 1) % order.size()]
		_set_status("Ставишь объект: %s" % obj_kind)
		return
	elif t == "❌":
		tool = "erase"
	elif t == "+Свои":
		tool = "add0"
	elif t == "+Враг":
		tool = "add1"
	elif t == "Класс":
		deploy_cls = CLS_ORDER[(CLS_ORDER.find(deploy_cls) + 1) % CLS_ORDER.size()]
	elif t == "Авто":
		_auto_rocks()
	elif t == "Очист":
		objects = {}
		_rebuild_rocks()
	elif t == "Сохран":
		_save_map()
		return
	elif t == "Загруз":
		_load_map()
		return
	elif t == "В БОЙ":
		_start_battle()
		return
	_set_status("Инструмент: %s | класс: %s" % [tool, CLASSES.get(deploy_cls, {}).get("name", deploy_cls)])
func _deploy_click(c):
	if not _in_grid(c):
		return
	var u = _unit_at(c)
	if tool == "rock":
		if u == null:
			if objects.has(c):
				objects.erase(c)
			else:
				objects[c] = obj_kind
			_rebuild_rocks()
	elif tool == "erase":
		if u != null:
			units.erase(u)
			u.queue_free()
		elif objects.has(c):
			objects.erase(c)
			_rebuild_rocks()
	elif tool == "add0" or tool == "add1":
		if u == null and not objects.has(c):
			spawn_unit(deploy_cls, c, 0 if tool == "add0" else 1)
	elif tool == "move":
		if u != null:
			deploy_sel = u
			_set_status("Выбран %s — кликни пустую клетку." % u.unit_name)
		elif deploy_sel != null and not objects.has(c):
			deploy_sel.cell = c
			deploy_sel.position = Vector2(c) * CELL + Vector2(32, 32)
			deploy_sel = null
func _rebuild_rocks():
	for n in get_tree().get_nodes_in_group("rocks"):
		n.queue_free()
	rocks = objects.keys()
	_spawn_rocks()
func _auto_rocks():
	objects = {}
	for i in range(7):
		var c = Vector2i(2 + randi() % 4, randi() % GRID_H)
		if _unit_at(c) == null and not objects.has(c):
			objects[c] = "tree" if randf() < 0.5 else "rock"
	_rebuild_rocks()
func _start_battle():
	var n0 = 0
	var n1 = 0
	for u in units:
		if u.team == 0:
			n0 += 1
		else:
			n1 += 1
	if n0 == 0 or n1 == 0:
		_set_status("Нужны бойцы с обеих сторон!")
		return
	deploy_mode = false
	toolbar.visible = false
	deploy_sel = null
	for u in units:
		u.reset_turn()
	selected = null
	acted_unit = null
	current_team = 0
	busy = false
	game_over = false
	_clear_hl()
	await _play_dlg(_loc_dlg("pre"))
	_set_status("Твой ход! F — шар, 1 — зелье, D — диалог.")
func _save_map():
	DirAccess.make_dir_recursive_absolute("res://data/maps")
	var d = {"rocks": [], "objects": [], "units": []}
	for c in objects:
		d["objects"].append({"cell": [c.x, c.y], "k": objects[c]})
		if objects[c] == "rock":
			d["rocks"].append([c.x, c.y])
	for u in units:
		d["units"].append({"cls": cls_of.get(u, "swordsman"), "team": u.team, "cell": [u.cell.x, u.cell.y]})
	var f = FileAccess.open("res://data/maps/test.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(d))
	f.close()
	_set_status("Карта сохранена в data/maps/test.json")
func _load_map():
	var f = FileAccess.open("res://data/maps/test.json", FileAccess.READ)
	if f == null:
		_set_status("Нет сохранённой карты.")
		return
	var j = JSON.parse_string(f.get_as_text())
	f.close()
	if j == null:
		return
	for u in units.duplicate():
		units.erase(u)
		u.queue_free()
	objects = {}
	for r in j.get("rocks", []):
		objects[Vector2i(r[0], r[1])] = "rock"
	for o in j.get("objects", []):
		objects[Vector2i(o["cell"][0], o["cell"][1])] = o.get("k", "rock")
	for e in j.get("units", []):
		spawn_unit(e.get("cls", "swordsman"), Vector2i(e["cell"][0], e["cell"][1]), int(e.get("team", 0)))
	_rebuild_rocks()
	_set_status("Карта загружена.")
func _build_potion_btn():
	potion_button = Button.new()
	potion_button.text = "Зелье: 0"
	add_child(potion_button)
	potion_button.position = end_turn_button.position + Vector2(end_turn_button.size.x + 8, 0)
	potion_button.pressed.connect(_use_potion)
func _use_potion():
	if selected == null or selected.team != 0 or busy or game_over or deploy_mode:
		return
	if Game.has_item("potion") and selected.hp < selected.max_hp:
		Game.remove_item("potion")
		selected.hp = min(selected.max_hp, selected.hp + int(ITEMS.get("potion", {}).get("heal", 1)))
		selected.queue_redraw()
		_float_text(selected.position, "+1", Color(0.4, 1, 0.4))
		_set_status("Зелье использовано.")
func _update_potion_btn():
	if potion_button != null:
		potion_button.text = "Зелье: %d" % Game.inventory.get("potion", 0)

func _weakest_player():
	var best = null
	var bh = 1e9
	for u in units:
		if u.team == 0 and u.is_alive() and u.hp < bh:
			bh = u.hp
			best = u
	return best

func _loc_dlg(slot):
	return LOCS.get(cur_loc, {}).get("dlg", {}).get(slot, "")
func _after_win():
	await _play_dlg(_loc_dlg("win"))
func _play_dlg(id):
	if id == "":
		return
	var f = FileAccess.open("res://data/dialogs/%s.json" % id, FileAccess.READ)
	if f == null:
		return
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	if data == null:
		return
	busy = true
	if dlg_node == null:
		dlg_node = load("res://scripts/dialog.gd").new()
		dlg_node.chars = CHARS
		add_child(dlg_node)
	await dlg_node.play(data)
	busy = false

func _melee_clear(a, t):
	if a.attack_range > 1:
		return true
	var d = t.cell - a.cell
	if abs(d.x) == 1 and abs(d.y) == 1:
		if rocks.has(a.cell + Vector2i(d.x, 0)) or rocks.has(a.cell + Vector2i(0, d.y)):
			return false
	return true

var journal_node = null
func _toggle_journal():
	if journal_node == null:
		journal_node = load("res://scripts/journal.gd").new()
		add_child(journal_node)
	else:
		journal_node.visible = not journal_node.visible
		if journal_node.visible:
			journal_node.refresh()


"""


func _run() -> void:
	DirAccess.make_dir_recursive_absolute("res://scripts")
	_write("res://scripts/unit.gd", UNIT_GD)
	_write("res://scripts/enemy_unit.gd", ENEMY_GD)
	_write("res://scripts/board.gd", BOARD_GD)
	_write("res://scripts/main.gd", MAIN_GD)
	EditorInterface.get_resource_filesystem().scan()

	var main: Node = null
	var need_pack := false

	if FileAccess.file_exists(MAIN_SCENE):
		var root := EditorInterface.get_edited_scene_root()
		var already := false
		if root != null:
			already = root.scene_file_path == MAIN_SCENE
		if already:
			main = root
		else:
			EditorInterface.open_scene_from_path(MAIN_SCENE)
			main = EditorInterface.get_edited_scene_root()
	else:
		main = Control.new()
		main.name = "Main"
		need_pack = true

	_ensure_tree(main)

	if need_pack:
		var ps := PackedScene.new()
		if ps.pack(main) == OK:
			ResourceSaver.save(ps, MAIN_SCENE)
		main.free()
		EditorInterface.open_scene_from_path(MAIN_SCENE)
	else:
		EditorInterface.save_scene()

	ProjectSettings.set_setting(
			"application/run/main_scene", MAIN_SCENE)
	ProjectSettings.save()
	print("ГОТОВО! Направления и зоны добавлены. Жми F5.")


func _ensure_tree(main: Node) -> void:
	main.set_script(_load_fresh("res://scripts/main.gd"))

	var board: Control = _get_or_make(main, "Board", "Control")
	board.set_script(_load_fresh("res://scripts/board.gd"))
	board.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_get_or_make(main, "Units", "Node2D")

	var status: Label = _get_or_make(main, "StatusLabel", "Label")
	status.position = Vector2(10, 8)
	status.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var btn: Button = _get_or_make(main, "EndTurnButton", "Button")
	btn.text = "Завершить ход"
	btn.position = Vector2(10, 32)


func _get_or_make(parent: Node,
		nname: String, ntype: String) -> Node:
	var n := parent.get_node_or_null(nname)
	if n != null:
		return n
	var created: Node
	match ntype:
		"Control":
			created = Control.new()
		"Node2D":
			created = Node2D.new()
		"Label":
			created = Label.new()
		"Button":
			created = Button.new()
		_:
			created = Node.new()
	created.name = nname
	parent.add_child(created)
	created.owner = parent
	return created


func _load_fresh(path: String) -> Resource:
	return ResourceLoader.load(path, "",
			ResourceLoader.CACHE_MODE_REPLACE)


func _write(path: String, content: String) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f:
		f.store_string(content)
		f.close()
