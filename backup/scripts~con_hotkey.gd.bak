extends Node
var con_win = null
func _unhandled_input(ev):
	if ev is InputEventKey and ev.pressed and ev.keycode == KEY_C:
		toggle()
func toggle():
	if con_win == null:
		open()
	else:
		con_win.visible = not con_win.visible
		if con_win.visible:
			_layout()
func open():
	if con_win == null:
		con_win = Window.new()
		con_win.title = "Конструктор"
		var con = load("res://scripts/constructor.gd").new()
		con.embedded = true
		con_win.add_child(con)
		get_tree().root.add_child(con_win)
		_layout()
	else:
		con_win.visible = true
func _layout():
	var screen = DisplayServer.screen_get_size()
	var half = int(screen.x * 0.5)
	DisplayServer.window_set_size(Vector2i(half - 6, 700))
	DisplayServer.window_set_position(Vector2i(0, 0))
	con_win.size = Vector2i(screen.x - half - 10, 760)
	con_win.position = Vector2i(half + 2, 0)

var work_node = null
func show_work():
	if work_node == null:
		work_node = load("res://scripts/work3d.gd").new()
		get_tree().root.add_child(work_node)
	work_node.visible = true
	work_node.set_process_unhandled_input(true)
	var cur = get_tree().current_scene
	if cur != null and cur != work_node:
		cur.visible = false
		cur.set_process_unhandled_input(false)
	_update_dbg()
func hide_work():
	if work_node != null:
		work_node.visible = false
		work_node.set_process_unhandled_input(false)
	var cur = get_tree().current_scene
	if cur != null and cur != work_node:
		cur.visible = true
		cur.set_process_unhandled_input(true)
	_update_dbg()

var dbg: Label
func _ready():
	dbg = Label.new()
	get_tree().root.add_child(dbg)
	dbg.position = Vector2(8, 660)
	dbg.modulate = Color(1, 1, 0.5)
	_update_dbg()
func _update_dbg():
	if dbg == null:
		return
	var ws = "null" if work_node == null else ("vis" if work_node.visible else "hid")
	dbg.text = "DBG: scene=%s work=%s loc=%s data=%s active=%s" % [str(get_tree().current_scene), ws, Game.edit_loc, str(Game.edit_data != null), str(Game.edit_active)]
