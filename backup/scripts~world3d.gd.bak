extends Node3D
var yaw_n: Node3D
var pitch_n: Node3D
var cam: Camera3D
var yaw = 0.6
var pitch = -0.9
var dist = 12.0
var target = Vector3(4, 0, 3)
var mid_drag = false
var right_drag = false
var CLASSES = {}
var units3 = []
var objects3 = []
var selected = -1
var move_hl = []
var attack_hl = []
var hl_root: Node3D
var busy = false
var terrain = null
var hovered = -1
var acted_idx = -1
var handled_click = false
var game_over3 = false
var status: Label
var info: Label
var LOCS = {}
var CHARS = {}
var OBJ3 = {}
var loc_id = ""
const PCLS = ["assassin", "swordsman", "halberd", "archer"]
func _ready():
	add_to_group("live")
	loc_id = Game.cur_loc
	_setup()
	CLASSES = _lj("res://data/classes.json")
	LOCS = _lj("res://data/locations.json")
	CHARS = _lj("res://data/chars.json")
	OBJ3 = _lj("res://data/objects.json")
	hl_root = Node3D.new()
	add_child(hl_root)
	_build()
	_apply()
	_ui()
	_play_dlg(LOCS.get(loc_id, {}).get("dlg", {}).get("pre", ""))
func _setup():
	yaw_n = Node3D.new()
	add_child(yaw_n)
	pitch_n = Node3D.new()
	yaw_n.add_child(pitch_n)
	cam = Camera3D.new()
	pitch_n.add_child(cam)
	cam.position = Vector3(0, 0, dist)
func _ui():
	var ui = Control.new()
	ui.set_anchors_preset(Control.PRESET_FULL_RECT)
	ui.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(ui)
	var btn = Button.new()
	btn.text = "Завершить ход"
	btn.position = Vector2(10, 10)
	btn.pressed.connect(_end_turn)
	ui.add_child(btn)
	status = Label.new()
	status.position = Vector2(10, 45)
	status.text = "Твой ход: клик по своему юниту."
	ui.add_child(status)
	info = Label.new()
	info.position = Vector2(10, 70)
	ui.add_child(info)
	var dev = Label.new()
	dev.position = Vector2(10, 95)
	dev.text = "M карта | C конструктор | клик по своему — выбор | по зелёной — ход | по врагу в радиусе — атака | Q/E поворот | колесо зум | ПКМ камера | СКМ сдвиг"
	dev.modulate = Color(0.7, 0.7, 0.7)
	ui.add_child(dev)
	_upd_info()
func _lj(p):
	var f = FileAccess.open(p, FileAccess.READ)
	if f == null:
		return {}
	var s = f.get_as_text()
	f.close()
	var j = JSON.parse_string(s)
	return {} if j == null else j
func _tex(path):
	if path == "" or not FileAccess.file_exists(path):
		return null
	var im = Image.new()
	if im.load(path) != OK:
		return null
	return ImageTexture.create_from_image(im)
func _mat_defs():
	var m = _lj("res://data/materials.json")
	var defs = []
	for k in m:
		defs.append({"col": Color(str(m[k].get("color", "#888888"))), "tex": str(m[k].get("tex", ""))})
	return defs
func _p(c):
	return Vector3(c.x + 0.5, 0, c.y + 0.5)
func _build():
	terrain = load("res://scripts/terrain.gd").new()
	add_child(terrain)
	terrain.set_materials(_mat_defs())
	var td = LOCS.get(loc_id, {}).get("terrain", {})
	if td.size() > 0:
		terrain.from_data(td)
	else:
		terrain.build()
	var camp = LOCS.get(loc_id, {}).get("map", {})
	for o in camp.get("objects", []):
		objects3.append(Vector2i(o["cell"][0], o["cell"][1]))
		_obj(Vector3(o["cell"][0] + 0.5, 0, o["cell"][1] + 0.5), o.get("k", "rock"))
	for r in camp.get("rocks", []):
		objects3.append(Vector2i(r[0], r[1]))
		_obj(Vector3(r[0] + 0.5, 0, r[1] + 0.5), "rock")
	var has0 = false
	for u in camp.get("units", []):
		if int(u.get("team", 1)) == 0:
			has0 = true
	if camp.get("units", []).size() == 0:
		for i in 4:
			_spawn_unit(Vector2i(6, 1 + i), 1, PCLS[i], Vector2(-1, 0))
		for i in 4:
			_spawn_unit(Vector2i(1, 1 + i), 0, PCLS[i], Vector2(1, 0))
	else:
		for u in camp.get("units", []):
			var tm = int(u.get("team", 1))
			_spawn_unit(Vector2i(u["cell"][0], u["cell"][1]), tm, u.get("cls", "swordsman"), Vector2(1, 0) if tm == 0 else Vector2(-1, 0))
	var dl = DirectionalLight3D.new()
	dl.rotation_degrees = Vector3(-50, 30, 0)
	add_child(dl)
	var env = Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = Color(0.05, 0.06, 0.08)
	var we = WorldEnvironment.new()
	we.environment = env
	add_child(we)
func _spawn_unit(c, team, cls, dir):
	var cd = CLASSES.get(cls, {})
	var sc = float(cd.get("scale", 1.0))
	var root = Node3D.new()
	root.position = _p(c) + Vector3(0, _th(c), 0)
	add_child(root)
	var img = cd.get("img", "")
	var t = _tex(img) if img != "" else null
	var mn = _model_inst(str(cd.get("model", ""))) if bool(cd.get("render3d", false)) else null
	if mn != null:
		var ms = float(cd.get("mscale", 1.0))
		mn.scale = Vector3(ms, ms, ms)
		mn.position.y += float(cd.get("myoff", 0.0))
		mn.rotation.y = atan2(-dir.y, dir.x)
		root.add_child(mn)
	elif t == null:
		var m = MeshInstance3D.new()
		var cm = CapsuleMesh.new()
		cm.radius = 0.28
		cm.height = 0.9
		var mi = StandardMaterial3D.new()
		mi.albedo_color = Color(0.2, 0.5, 0.9) if team == 0 else Color(0.9, 0.25, 0.25)
		cm.material = mi
		m.mesh = cm
		m.position = Vector3(0, 0.45, 0)
		root.add_child(m)
	else:
		var sp = Sprite3D.new()
		sp.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
		sp.pixel_size = 0.004
		sp.scale = Vector3(sc, sc, sc)
		sp.position = Vector3(0, 0.85 * sc + float(cd.get("yoff", 0.0)), 0)
		sp.texture = t
		root.add_child(sp)
	var holder = Node3D.new()
	holder.position = Vector3(0, 0.05, 0)
	holder.rotation.y = atan2(-dir.y, dir.x)
	root.add_child(holder)
	var cone = MeshInstance3D.new()
	var cm2 = CylinderMesh.new()
	cm2.top_radius = 0.02
	cm2.bottom_radius = 0.11
	cm2.height = 0.4
	var ma = StandardMaterial3D.new()
	ma.albedo_color = Color(0.2, 0.5, 0.9).lightened(0.4) if team == 0 else Color(0.9, 0.25, 0.25).lightened(0.4)
	cm2.material = ma
	cone.mesh = cm2
	cone.rotation.z = -PI / 2
	cone.position = Vector3(0.32, 0, 0)
	holder.add_child(cone)
	var hbar_y = 1.8 * sc if t != null else 1.3
	var bar = MeshInstance3D.new()
	var bq = QuadMesh.new()
	bq.size = Vector2(0.7, 0.1)
	var mf = StandardMaterial3D.new()
	mf.albedo_color = Color(0.2, 0.9, 0.2)
	mf.billboard_mode = BaseMaterial3D.BILLBOARD_FIXED_Y
	bq.material = mf
	bar.mesh = bq
	bar.position = Vector3(0, hbar_y, 0)
	root.add_child(bar)
	var lb = Label3D.new()
	lb.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	lb.text = str(cd.get("name", cls))
	lb.pixel_size = 0.004
	lb.position = Vector3(0, hbar_y + 0.3, 0)
	lb.modulate = Color(1, 1, 1) if team == 0 else Color(1, 0.6, 0.6)
	root.add_child(lb)
	var area = Area3D.new()
	area.input_ray_pickable = true
	area.collision_layer = 2
	var csh = CollisionShape3D.new()
	var shp = CapsuleShape3D.new()
	shp.radius = 0.45
	shp.height = 1.8 * sc
	csh.shape = shp
	csh.position = Vector3(0, 0.9 * sc, 0)
	area.add_child(csh)
	root.add_child(area)
	area.input_event.connect(_on_area_click.bind(units3.size()))
	units3.append({"cell": c, "team": team, "cls": cls, "hp": int(cd.get("hp", 2)), "maxhp": int(cd.get("hp", 2)), "facing": dir, "root": root, "bar": bar, "arrow": holder, "moved": false, "attacked": false})
func _obj(p, k):
	p.y = terrain.sample_h(p.x, p.z) if terrain != null else 0.0
	var od = OBJ3.get(k, {})
	var mn = _model_inst(str(od.get("model", ""))) if bool(od.get("render3d", false)) else null
	if mn != null:
		var ms = float(od.get("mscale", 1.0))
		mn.scale = Vector3(ms, ms, ms)
		mn.position = p + Vector3(0, float(od.get("myoff", 0.0)), 0)
		add_child(mn)
		return
	var oimg = str(od.get("img", ""))
	var ot = _tex(oimg) if oimg != "" else null
	if ot != null:
		var h = 1.2 * float(od.get("scale", 1.0))
		var sp = Sprite3D.new()
		sp.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
		sp.pixel_size = h / float(ot.get_height())
		sp.texture = ot
		sp.position = p + Vector3(0, h * 0.5, 0)
		add_child(sp)
		return
	var m = MeshInstance3D.new()
	var mi = StandardMaterial3D.new()
	if k == "tree":
		var cm = CylinderMesh.new()
		cm.top_radius = 0.05
		cm.bottom_radius = 0.42
		cm.height = 1.0
		mi.albedo_color = Color(0.15, 0.4, 0.2)
		cm.material = mi
		m.mesh = cm
		m.position = p + Vector3(0, 0.5, 0)
	else:
		var bm = BoxMesh.new()
		bm.size = Vector3(0.7, 0.5, 0.7)
		mi.albedo_color = Color(0.45, 0.45, 0.5)
		bm.material = mi
		m.mesh = bm
		m.position = p + Vector3(0, 0.25, 0)
	add_child(m)
func _model_inst(path):
	if path == "" or not FileAccess.file_exists(path):
		return null
	var res = load(path)
	if res is PackedScene:
		return res.instantiate()
	return null
func _cheb(a, b):
	return max(abs(a.x - b.x), abs(a.y - b.y))
func _unit_at(c):
	for i in units3.size():
		if units3[i].hp > 0 and units3[i].cell == c:
			return i
	return -1
func _ar(u):
	return int(CLASSES.get(u.cls, {}).get("ar", 1))
func _mv(u):
	return int(CLASSES.get(u.cls, {}).get("move", 3))
func _bfs(start, rng):
	var res = []
	var dist = {start: 0}
	var fr = [start]
	while fr.size() > 0:
		var nxt = []
		for c in fr:
			if dist[c] >= rng:
				continue
			for d in [Vector2i(1,0), Vector2i(-1,0), Vector2i(0,1), Vector2i(0,-1)]:
				var n = c + d
				if n.x < 0 or n.y < 0 or n.x >= 8 or n.y >= 6:
					continue
				if objects3.has(n) or dist.has(n) or _unit_at(n) >= 0:
					continue
				if terrain != null and not terrain.can_move(c.x, c.y, n.x, n.y):
					continue
				dist[n] = dist[c] + 1
				res.append(n)
				nxt.append(n)
		fr = nxt
	return res
func _select(i):
	if acted_idx >= 0 and acted_idx != i:
		status.text = "За ход одна фигура. Нажмите «Завершить ход»."
		return
	selected = i
	_compute_hl()
	status.text = "Выбран %s: зелёные — ход, красные — атака." % CLASSES.get(units3[i].cls, {}).get("name", "")
	_upd_info()
func _compute_hl():
	for c in hl_root.get_children():
		c.queue_free()
	move_hl = []
	attack_hl = []
	if selected < 0 or units3[selected].hp <= 0:
		return
	var u = units3[selected]
	if not u.moved:
		move_hl = _bfs(u.cell, _mv(u))
	if not u.attacked:
		for j in units3.size():
			var t = units3[j]
			if t.team != u.team and t.hp > 0 and _cheb(u.cell, t.cell) <= _ar(u):
				attack_hl.append(t.cell)
	for c in move_hl:
		_hl_quad(c, Color(0.2, 0.9, 0.3, 0.5))
	for c in attack_hl:
		_hl_quad(c, Color(0.9, 0.2, 0.2, 0.5))
	if selected >= 0:
		_disc(units3[selected].cell, Color(1, 0.85, 0.2, 0.6), 0.4)
func _hl_quad(c, col):
	var m = MeshInstance3D.new()
	var q = QuadMesh.new()
	q.size = Vector2(0.9, 0.9)
	var mi = StandardMaterial3D.new()
	mi.albedo_color = col
	mi.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	q.material = mi
	m.mesh = q
	m.rotation_degrees = Vector3(-90, 0, 0)
	m.position = Vector3(c.x + 0.5, 0.02 + _th(c), c.y + 0.5)
	hl_root.add_child(m)
func _disc(c, col, r):
	var m = MeshInstance3D.new()
	var cm = CylinderMesh.new()
	cm.top_radius = r
	cm.bottom_radius = r
	cm.height = 0.03
	var mi = StandardMaterial3D.new()
	mi.albedo_color = col
	mi.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	cm.material = mi
	m.mesh = cm
	m.position = Vector3(c.x + 0.5, 0.04 + _th(c), c.y + 0.5)
	hl_root.add_child(m)
func _pick_cell():
	var m = get_viewport().get_mouse_position()
	var c3 = get_viewport().get_camera_3d()
	var from = c3.project_ray_origin(m)
	var dir = c3.project_ray_normal(m)
	if abs(dir.y) < 0.0001:
		return null
	var t = -from.y / dir.y
	if t < 0:
		return null
	var p = from + dir * t
	var cx = int(p.x)
	var cz = int(p.z)
	if cx < 0 or cz < 0 or cx >= 8 or cz >= 6:
		return null
	return Vector2i(cx, cz)
func _dir_to(d):
	if abs(d.x) >= abs(d.y):
		return Vector2(sign(d.x), 0)
	return Vector2(0, sign(d.y))
func _set_face(u, d):
	u.facing = d
	u.arrow.rotation.y = atan2(-d.y, d.x)
func _move_to(i, c):
	var u = units3[i]
	_set_face(u, _dir_to(c - u.cell))
	u.cell = c
	u.moved = true
	var tw = create_tween()
	tw.tween_property(u.root, "position", _p(c) + Vector3(0, _th(c), 0), 0.25)
	if u.team == 0:
		acted_idx = i
		status.text = "Фигура походила — атакуй ей или заверши ход."
	_compute_hl()
func _zone_of(t, attacker_cell):
	var d = Vector2(attacker_cell.x - t.cell.x, attacker_cell.y - t.cell.y).normalized()
	var f = t.facing.normalized()
	var dot = f.x * d.x + f.y * d.y
	if dot <= -0.7:
		return "back"
	if dot >= 0.7:
		return "front"
	return "side"
func _attack(i, j):
	var u = units3[i]
	var t = units3[j]
	u.attacked = true
	if u.team == 0:
		acted_idx = i
		selected = -1
		_set_face(u, _dir_to(t.cell - u.cell))
	var cd = CLASSES.get(u.cls, {})
	var z = _zone_of(t, u.cell)
	var cf = float(cd.get("cf", 0.6))
	var cbk = float(cd.get("cb", 0.6))
	var chance = cbk if z == "back" else (cf if z == "front" else (cf + cbk) * 0.5)
	var zname = "спина" if z == "back" else ("лоб" if z == "front" else "бок")
	var who = "Ты" if u.team == 0 else "Враг"
	if randf() < chance:
		t.hp -= 1
		t.bar.scale.x = maxf(0.05, float(t.hp) / float(t.maxhp))
		_float_text(t.root.position, "-1", Color(1, 0.3, 0.3))
		if t.hp <= 0:
			t.root.visible = false
			status.text = "%s: попадание в %s — убит!" % [who, zname]
	else:
		_float_text(t.root.position, "МИМО", Color(0.8, 0.8, 0.8))
		status.text = "%s: промах (%s, шанс %d%%)." % [who, zname, int(chance * 100)]
	_compute_hl()
	_check_end()
	_upd_info()
	if u.team == 0 and not game_over3:
		status.text = "%s действовал. Нажмите «Завершить ход»." % CLASSES.get(u.cls, {}).get("name", "")
func _end_turn():
	if busy or game_over3:
		return
	busy = true
	acted_idx = -1
	_upd_info()
	selected = -1
	_compute_hl()
	status.text = "Ход врагов…"
	_enemy_phase()
func _enemy_phase():
	var acted = false
	for i in units3.size():
		var u = units3[i]
		if u.team != 1 or u.hp <= 0:
			continue
		var action = _ai_decide(i)
		if action.size() > 0:
			status.text = "Враг: %s действует…" % CLASSES.get(u.cls, {}).get("name", "")
			await get_tree().create_timer(0.35).timeout
			if action.has("move_to"):
				var step = action["move_to"]
				_set_face(u, _dir_to(step - u.cell))
				u.cell = step
				u.root.position = _p(step) + Vector3(0, _th(step), 0)
				await get_tree().create_timer(0.2).timeout
			if action.has("attack") and units3[action["attack"]].hp > 0:
				_attack(i, action["attack"])
			acted = true
			break
	if not acted:
		status.text = "Враги выжидают."
		await get_tree().create_timer(0.3).timeout
	for u in units3:
		u.moved = false
		u.attacked = false
	busy = false
	acted_idx = -1
	if not game_over3:
		status.text = "Твой ход: клик по своему юниту."
	_upd_info()
	_check_end()
func _nearest_player(c):
	var bi = -1
	var bd = 99
	for i in units3.size():
		var u = units3[i]
		if u.team == 0 and u.hp > 0:
			var d = _cheb(c, u.cell)
			if d < bd:
				bd = d
				bi = i
	return bi
func _best_step(u, tcell):
	var best = null
	var bd = _cheb(u.cell, tcell)
	for c in _bfs(u.cell, _mv(u)):
		var d = _cheb(c, tcell)
		if d < bd:
			bd = d
			best = c
	return best
func _ai_decide(i):
	var u = units3[i]
	var ti = -1
	var bh = 999
	for j in units3.size():
		var t = units3[j]
		if t.team == 0 and t.hp > 0 and _can_hit(u.cell, t.cell):
			if t.hp < bh:
				bh = t.hp
				ti = j
	if ti >= 0:
		return {"attack": ti}
	ti = _nearest_player(u.cell)
	if ti < 0:
		return {}
	var t = units3[ti]
	var res = {}
	var move_to = _step_toward_enemy(i, ti)
	if move_to != null:
		res["move_to"] = move_to
		if _cheb(move_to, t.cell) <= _ar(u):
			res["attack"] = ti
	return res
func _can_hit(from, to):
	var u_from = null
	for uu in units3:
		if uu.cell == from:
			u_from = uu
			break
	if u_from == null:
		return false
	var d = to - from
	if _cheb(from, to) > _ar(u_from):
		return false
	if _ar(u_from) == 1 and abs(d.x) == 1 and abs(d.y) == 1:
		if objects3.has(from + Vector2i(d.x, 0)) or objects3.has(from + Vector2i(0, d.y)):
			return false
	return true
func _step_toward_enemy(i, ti):
	var u = units3[i]
	var t = units3[ti]
	var dist = {u.cell: 0}
	var frontier = [u.cell]
	while frontier.size() > 0:
		var nxt = []
		for c in frontier:
			if dist[c] >= _mv(u):
				continue
			for d in [Vector2i(1,0),Vector2i(-1,0),Vector2i(0,1),Vector2i(0,-1)]:
				var n = c + d
				if n.x < 0 or n.y < 0 or n.x >= 8 or n.y >= 6:
					continue
				if objects3.has(n) or dist.has(n):
					continue
				if _unit_at(n) >= 0:
					continue
				dist[n] = dist[c] + 1
				nxt.append(n)
		frontier = nxt
	var cur_s = _ai_score(u.cell, t, i)
	var best = null
	var bs = cur_s - 0.001
	for c in dist:
		if c == u.cell:
			continue
		var s2 = _ai_score(c, t, i)
		if s2 < bs:
			bs = s2
			best = c
	return best
func _ai_score(c, t, i):
	var u = units3[i]
	var s = float(_cheb(c, t.cell)) * 10.0
	if _cheb(c, t.cell) <= _ar(u):
		s -= 50.0
	var d = Vector2(c.x - t.cell.x, c.y - t.cell.y)
	var dl = d.length()
	if dl > 0.001:
		var fd = t.facing
		var dot = (fd.x * d.x + fd.y * d.y) / dl
		if dot <= -0.7:
			s -= 1.0
		elif dot < 0.7:
			s -= 0.5
	s += (c.x + c.y) * 0.01
	return s
func _check_end():
	var p = 0
	var e = 0
	for u in units3:
		if u.hp > 0:
			if u.team == 0:
				p += 1
			else:
				e += 1
	if e == 0:
		game_over3 = true
		_on_win()
	elif p == 0:
		game_over3 = true
		_play_dlg(LOCS.get(loc_id, {}).get("dlg", {}).get("loss", ""))
		status.text = "ПОРАЖЕНИЕ… M — на карту."
func _on_win():
	var L = LOCS.get(loc_id, {})
	Game.flags["clear_" + loc_id] = true
	Game.clear_hook(loc_id)
	var got = []
	for row in L.get("loot", []):
		if randf() * 100.0 < float(row.get("chance", 0)):
			Game.add_item(row.get("item", "potion"), 1)
			got.append(str(row.get("item", "")))
	var rep = ", ".join(got) if got.size() > 0 else "ничего"
	_play_dlg(L.get("dlg", {}).get("win", ""))
	status.text = "ПОБЕДА! Лут: %s. M — на карту." % rep
func _play_dlg(dn):
	if dn == "":
		return
	var f = FileAccess.open("res://data/dialogs/%s.json" % dn, FileAccess.READ)
	if f == null:
		return
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	if data == null:
		return
	var d = load("res://scripts/dialog.gd").new()
	d.chars = CHARS
	add_child(d)
	d.play(data)
func _float_text(pos, txt, col):
	var lb = Label3D.new()
	lb.text = txt
	lb.pixel_size = 0.006
	lb.modulate = col
	lb.position = pos + Vector3(0, 2.2, 0)
	add_child(lb)
	var tw = create_tween()
	tw.tween_property(lb, "position:y", lb.position.y + 0.8, 0.8)
	tw.parallel().tween_property(lb, "modulate:a", 0.0, 0.8)
	tw.tween_callback(lb.queue_free)
func _th(c):
	return terrain.cell_h(c.x, c.y) if terrain != null else 0.0
func _apply():
	yaw_n.position = target
	yaw_n.rotation = Vector3(0, yaw, 0)
	pitch_n.rotation = Vector3(pitch, 0, 0)
	cam.position = Vector3(0, 0, dist)
func _upd_info():
	if info == null:
		return
	if acted_idx < 0:
		info.text = "За раунд: 1 ход и 1 атака одной фигурой. Сейчас всё доступно."
	else:
		var u = units3[acted_idx]
		info.text = "%s: ходов осталось %d, атак осталось %d." % [CLASSES.get(u.cls, {}).get("name", ""), 0 if u.moved else 1, 0 if u.attacked else 1]
func _on_area_click(_cam, ev, _p2, _n, _si, i):
	if not (ev is InputEventMouseButton) or not ev.pressed or ev.button_index != MOUSE_BUTTON_LEFT or busy:
		return
	handled_click = true
	var u = units3[i]
	if u.hp <= 0:
		return
	if u.team == 0:
		if acted_idx >= 0 and acted_idx != i:
			status.text = "За ход действует одна фигура."
			return
		_select(i)
	elif selected >= 0 and attack_hl.has(u.cell):
		_attack(selected, i)
func _click_action():
	if handled_click:
		handled_click = false
		return
	var c = _pick_cell()
	if c == null:
		return
	if selected >= 0 and move_hl.has(c):
		_move_to(selected, c)
	else:
		selected = -1
		_compute_hl()
func _unhandled_input(ev):
	if ev is InputEventKey and ev.pressed:
		if ev.keycode == KEY_M:
			get_tree().change_scene_to_file("res://overworld3d.tscn")
			return
		if selected >= 0 and not busy:
			if ev.keycode == KEY_Q:
				var u = units3[selected]
				var a = -PI / 4.0
				var f = u.facing
				var nf = Vector2(f.x * cos(a) - f.y * sin(a), f.x * sin(a) + f.y * cos(a))
				nf = Vector2(round(nf.x * 2) / 2, round(nf.y * 2) / 2)
				if nf != Vector2.ZERO:
					_set_face(u, nf)
					_compute_hl()
				return
			if ev.keycode == KEY_E:
				var u = units3[selected]
				var a = PI / 4.0
				var f = u.facing
				var nf = Vector2(f.x * cos(a) - f.y * sin(a), f.x * sin(a) + f.y * cos(a))
				nf = Vector2(round(nf.x * 2) / 2, round(nf.y * 2) / 2)
				if nf != Vector2.ZERO:
					_set_face(u, nf)
					_compute_hl()
				return
	if ev is InputEventMouseButton:
		if ev.button_index == MOUSE_BUTTON_RIGHT:
			right_drag = ev.pressed
		elif ev.button_index == MOUSE_BUTTON_MIDDLE:
			mid_drag = ev.pressed
		elif ev.pressed and ev.button_index == MOUSE_BUTTON_WHEEL_UP:
			dist = clampf(dist - 1.0, 4, 30)
			_apply()
		elif ev.pressed and ev.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			dist = clampf(dist + 1.0, 4, 30)
			_apply()
		elif ev.button_index == MOUSE_BUTTON_LEFT and ev.pressed and not busy:
			_click_action()
	elif ev is InputEventMouseMotion:
		if right_drag:
			yaw -= ev.relative.x * 0.005
			pitch = clampf(pitch - ev.relative.y * 0.005, -1.45, -0.15)
			_apply()
		elif mid_drag:
			var k = dist * 0.0016
			var right = yaw_n.global_transform.basis.x
			var fwd = -yaw_n.global_transform.basis.z
			target -= right * ev.relative.x * k
			target += fwd * ev.relative.y * k
			_apply()
