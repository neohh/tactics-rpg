extends Control
var LOCS = {}
var CHARS = {}
var dlg_node = null
var busy = false
var decor = {}
func _ready():
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	LOCS = _load_json("res://data/locations.json")
	CHARS = _load_json("res://data/chars.json")
	decor = {}
	for id in LOCS:
		var L = LOCS[id]
		var d = L.get("decor", [])
		decor[id] = d if d.size() > 0 else _gen_decor(id, L.get("type", "field"))
	queue_redraw()
func _load_json(p):
	var f = FileAccess.open(p, FileAccess.READ)
	if f == null:
		return {}
	var s = f.get_as_text()
	f.close()
	var j = JSON.parse_string(s)
	return {} if j == null else j
func _draw():
	draw_rect(Rect2(0, 0, size.x, size.y), Color(0.07, 0.09, 0.07))
	for id in LOCS:
		var base = Vector2(LOCS[id]["pos"][0], LOCS[id]["pos"][1])
		for it in decor.get(id, []):
			var p = base + Vector2(it.get("x", 0), it.get("y", 0))
			var s = float(it.get("s", 1.0))
			var k = it.get("k", "tree")
			if it.has("img") and ResourceLoader.exists(it["img"]):
				draw_texture_rect(load(it["img"]), Rect2(p.x - 16 * s, p.y - 16 * s, 32 * s, 32 * s), false)
			elif k == "tree":
				_draw_tree(p, s)
			elif k == "house":
				_draw_house(p, s)
			elif k == "tent":
				_draw_tent(p, s)
			elif k == "rock":
				_draw_rock(p, s)
			elif k == "fire":
				_draw_fire(p, s)
	for id in LOCS:
		var L = LOCS[id]
		for l2 in L.get("links", []):
			if LOCS.has(l2) and id < l2:
				draw_line(Vector2(L["pos"][0], L["pos"][1]), Vector2(LOCS[l2]["pos"][0], LOCS[l2]["pos"][1]), Color(0.5, 0.5, 0.5, 0.6), 2.0)
	var font = ThemeDB.fallback_font
	for id in LOCS:
		var L = LOCS[id]
		var p = Vector2(L["pos"][0], L["pos"][1])
		var col = {"town": Color(0.9,0.8,0.3), "camp": Color(0.9,0.3,0.2), "cave": Color(0.6,0.3,0.8), "field": Color(0.5,0.7,0.4)}.get(L.get("type", "field"), Color(0.6,0.6,0.6))
		if Game.flags.get("clear_" + id, false):
			col = col.lerp(Color.WHITE, 0.5)
		draw_circle(p, 22, col)
		if id == Game.cur_loc:
			draw_arc(p, 26, 0, TAU, 32, Color.WHITE, 2.0)
		draw_string(font, p + Vector2(-80, 44), L.get("name", id), HORIZONTAL_ALIGNMENT_CENTER, 160, 14, Color.WHITE)
	draw_string(font, Vector2(10, 20), "День %d %02d:00 | Еда: %d | Усталость: %d | Золото: %d | Зелья: %d" % [Game.day, Game.hour, Game.food, Game.fatigue, Game.gold, Game.inventory.get("potion", 0)], HORIZONTAL_ALIGNMENT_LEFT, -1, 16, Color.WHITE)
	draw_string(font, Vector2(10, 40), "Клик — переход | S — спать | B — бой | T — тест | H — лавка | G/L — сейв/лоад | J — журнал", HORIZONTAL_ALIGNMENT_LEFT, -1, 13, Color(0.7, 0.7, 0.7))
func _unhandled_input(ev):
	if busy:
		return
	if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
		for id in LOCS:
			var p = Vector2(LOCS[id]["pos"][0], LOCS[id]["pos"][1])
			if (ev.position - p).length() < 26:
				_go(id)
				return
	if ev is InputEventKey and ev.pressed:
		if ev.keycode == KEY_J:
			_toggle_journal()
			return
		if ev.keycode == KEY_S:
			_sleep()
		elif ev.keycode == KEY_T:
			Game.cur_loc = "test"
			_go_battle()
		elif ev.keycode == KEY_B:
			_go_battle()
		elif ev.keycode == KEY_H:
			_open_shop()
		elif ev.keycode == KEY_G:
			Game.save_game()
			queue_redraw()
		elif ev.keycode == KEY_L:
			if Game.load_game():
				queue_redraw()
func _go(id):
	if id == Game.cur_loc:
		_go_battle_if_any()
		return
	var cur = LOCS.get(Game.cur_loc, {})
	if not cur.get("links", []).has(id):
		return
	var a = Vector2(cur["pos"][0], cur["pos"][1])
	var b = Vector2(LOCS[id]["pos"][0], LOCS[id]["pos"][1])
	var h = max(2, int(a.distance_to(b) / 80))
	Game.hour += h
	while Game.hour >= 24:
		Game.hour -= 24
		Game.day += 1
		_food()
	Game.cur_loc = id
	queue_redraw()
	await _play_dlg(LOCS[id].get("dlg", {}).get("arrive", ""))
	_go_battle_if_any()
func _food():
	if Game.food > 0:
		Game.food -= 1
	else:
		Game.fatigue += 1
func _sleep():
	Game.day += 1
	Game.hour = 8
	if Game.food > 0:
		Game.food -= 1
		Game.fatigue = 0
	else:
		Game.fatigue += 1
	queue_redraw()
func _go_battle_if_any():
	var L = LOCS.get(Game.cur_loc, {})
	if L.get("map", {}).size() > 0 and not Game.flags.get("clear_" + Game.cur_loc, false):
		_go_battle()
func _go_battle():
	get_tree().change_scene_to_file("res://main.tscn")
func _play_dlg(id):
	if id == "":
		return
	var f = FileAccess.open("res://data/dialogs/%s.json" % id, FileAccess.READ)
	if f == null:
		return
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	if data == null:
		return
	busy = true
	if dlg_node == null:
		dlg_node = load("res://scripts/dialog.gd").new()
		dlg_node.chars = CHARS
		add_child(dlg_node)
	await dlg_node.play(data)
	busy = false
	queue_redraw()

func _gen_decor(id, type):
	var rng = RandomNumberGenerator.new()
	rng.seed = hash(id)
	var items = []
	var recipe = {"town": [["house", 5], ["tree", 4], ["fire", 1]], "camp": [["tree", 9], ["tent", 2], ["fire", 1]], "cave": [["rock", 6], ["tree", 4]], "field": [["tree", 6], ["rock", 2]]}.get(type, [["tree", 4]])
	for pair in recipe:
		for i in range(pair[1]):
			var a = rng.randf() * TAU
			var r = 45 + rng.randf() * 65
			items.append({"k": pair[0], "x": round(cos(a) * r * 1.3), "y": round(sin(a) * r * 0.8), "s": 0.8 + rng.randf() * 0.5})
	return items
func _draw_tree(p, s):
	draw_rect(Rect2(p.x - 2 * s, p.y, 4 * s, 8 * s), Color(0.35, 0.25, 0.15))
	draw_circle(p + Vector2(0, -6 * s), 8 * s, Color(0.15, 0.4, 0.2))
func _draw_house(p, s):
	draw_rect(Rect2(p.x - 10 * s, p.y - 8 * s, 20 * s, 12 * s), Color(0.75, 0.6, 0.4))
	draw_colored_polygon(PackedVector2Array([Vector2(p.x - 12 * s, p.y - 8 * s), Vector2(p.x + 12 * s, p.y - 8 * s), Vector2(p.x, p.y - 18 * s)]), Color(0.6, 0.2, 0.15))
	draw_rect(Rect2(p.x - 3 * s, p.y - 2 * s, 6 * s, 6 * s), Color(0.3, 0.2, 0.1))
func _draw_tent(p, s):
	draw_colored_polygon(PackedVector2Array([Vector2(p.x - 9 * s, p.y + 5 * s), Vector2(p.x + 9 * s, p.y + 5 * s), Vector2(p.x, p.y - 9 * s)]), Color(0.7, 0.65, 0.55))
func _draw_rock(p, s):
	draw_colored_polygon(PackedVector2Array([Vector2(p.x - 7 * s, p.y + 4 * s), Vector2(p.x - 5 * s, p.y - 5 * s), Vector2(p.x + 3 * s, p.y - 6 * s), Vector2(p.x + 7 * s, p.y + 2 * s)]), Color(0.45, 0.45, 0.5))
func _draw_fire(p, s):
	draw_circle(p, 4 * s, Color(1, 0.45, 0.1))
	draw_circle(p + Vector2(0, -1), 2 * s, Color(1, 0.8, 0.2))

var journal_node = null
func _toggle_journal():
	if journal_node == null:
		journal_node = load("res://scripts/journal.gd").new()
		add_child(journal_node)
	else:
		journal_node.visible = not journal_node.visible
		if journal_node.visible:
			journal_node.refresh()

func _open_shop():
	var L = LOCS.get(Game.cur_loc, {})
	if L.get("shop", []).size() == 0 and L.get("type", "") != "town":
		return
	var s = load("res://scripts/shop.gd").new()
	s.stock = L.get("shop", ["potion", "food"])
	add_child(s)
